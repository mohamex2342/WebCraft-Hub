{
  "version": 2,
  "name": "webcraft-hub",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/files/html-platform",
      "destination": "/files/html-platform"
    },
    {
      "source": "/files/css-platform",
      "destination": "/files/css-platform"
    },
    {
      "source": "/files/js-platform",
      "destination": "/files/js-platform"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
