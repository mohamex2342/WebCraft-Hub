{
  "version": 2,
  "name": "webcraft-hub",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/files/html-platform",
      "destination": "/files/html-platform.html"
    },
    {
      "source": "/files/css-platform",
      "destination": "/files/css-platform.html"
    },
    {
      "source": "/files/js-platform",
      "destination": "/files/js-platform.html"
    },
    {
      "source": "/((?!files|assets|css|js|.*\\..*$).*)",
      "destination": "/"
    }
  ]
}
